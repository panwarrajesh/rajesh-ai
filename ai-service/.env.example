# Local models (default)
OLLAMA_URL=http://localhost:11434

# Optional external API (any OpenAI-compatible server). Keys stay server-side.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=model-a,model-b

# Optional: your own PyTorch GPT (see custom_gpt_adapter.example.py)
# CUSTOM_GPT_ADAPTER=custom_gpt_adapter

# OCR languages (Tesseract codes joined by +). Install the matching language packs.
OCR_LANGS=eng+hin
# Images are shrunk to this many pixels on the longest side before a vision model sees them.
MAX_IMAGE_SIDE=1568
# Lines below list extra vision-capable model names for the OpenAI-compatible provider (comma-separated)
# OPENAI_VISION_MODELS=my-vision-model
