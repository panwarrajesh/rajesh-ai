# Local models (default)
OLLAMA_URL=http://localhost:11434

# Optional external API (any OpenAI-compatible server). Keys stay server-side.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=model-a,model-b

# Optional: your own PyTorch GPT (see custom_gpt_adapter.example.py)
# CUSTOM_GPT_ADAPTER=custom_gpt_adapter

# OCR languages (Tesseract codes joined by +). Install the matching language packs.
OCR_LANGS=eng+hin
# Images are shrunk to this many pixels on the longest side before a vision model sees them.
MAX_IMAGE_SIDE=1568
# Lines below list extra vision-capable model names for the OpenAI-compatible provider (comma-separated)
# OPENAI_VISION_MODELS=my-vision-model

# Phase 3: audio/video
# Whisper model: tiny, base, small, medium, large-v3 (bigger = more accurate, esp. for Hindi; needs more RAM/GPU)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE=auto
# WHISPER_LANGUAGE=hi        # force a language instead of auto-detect
VIDEO_FRAMES=8
MAX_MEDIA_MINUTES=240
# Ollama context window. Ollama's own default is small and silently cuts long prompts.
OLLAMA_NUM_CTX=8192

# Phase 4: set to 1 if your OpenAI-compatible server does not support function/tool calling
# OPENAI_NO_TOOLS=1

# Phase 5: image generation / AI image editing (pick ONE provider; editing and generating also need no GPU here)
# IMAGE_PROVIDER=openai          # hosted: any OpenAI-compatible images API
# IMAGE_API_KEY=sk-...           # falls back to OPENAI_API_KEY
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=gpt-image-1        # check your provider's current model name; dall-e-* can generate but not edit
# IMAGE_PROVIDER=a1111           # local: Stable Diffusion WebUI started with --api (needs a GPU on that machine)
# A1111_URL=http://localhost:7860
# A1111_BASE_SIZE=768            # 512 for SD 1.5, 1024 for SDXL
# A1111_STEPS=25

# Phase 5: set the same random secret here and in backend/.env so only the backend can call this service
# INTERNAL_TOKEN=change-me-to-a-long-random-string
