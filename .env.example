# Copy to .env next to docker-compose.yml. Required:
APP_PASSWORD=choose-a-long-password
# Shared secret between backend and AI service. Make one with:  openssl rand -hex 32
INTERNAL_TOKEN=

# Optional
# WEB_PORT=8080
# COOKIE_SECURE=1                 # set to 1 when you serve it over HTTPS
# SESSION_SECRET=
# OLLAMA_URL=http://ollama:11434  # when using --profile ollama
# WHISPER_MODEL=small             # medium / large-v3 for better Hindi (needs more RAM)
# IMAGE_PROVIDER=openai           # or a1111; see ai-service/.env.example
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-1
# A1111_URL=http://host.docker.internal:7860
