PORT=5000
AI_SERVICE_URL=http://localhost:8000
DATA_DIR=./data
# Rough context budget (characters) sent to the model; older messages are dropped first.
MAX_CONTEXT_CHARS=24000
# Phase 2
UPLOAD_MAX_MB=25
# How much attached-file text (characters) is put in front of the model per request.
DOC_BUDGET_CHARS=16000
# Only the newest N images are sent as pixels; older ones keep just their OCR text.
MAX_IMAGES_IN_CONTEXT=4
