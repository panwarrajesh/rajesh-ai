PORT=5000
AI_SERVICE_URL=http://localhost:8000
DATA_DIR=./data
# Rough context budget (characters) sent to the model; older messages are dropped first.
MAX_CONTEXT_CHARS=24000
# Phase 2
UPLOAD_MAX_MB=25
# How much attached-file text (characters) is put in front of the model per request.
DOC_BUDGET_CHARS=16000
# Only the newest N images are sent as pixels; older ones keep just their OCR text.
MAX_IMAGES_IN_CONTEXT=4
# Phase 3
MEDIA_MAX_MB=500
# Long files: each part sent to the model while summarizing (characters) and max parts per request
SUMMARY_WINDOW_CHARS=6000
SUMMARY_MAX_PARTS=24
MAX_VIDEO_FRAMES_IN_CONTEXT=8
# Phase 4
DEFAULT_TIMEZONE=Asia/Kolkata
MEMORY_CHAR_BUDGET=3000
MAX_TOOL_ROUNDS=5
# Project workspace limits
WORKSPACE_MAX_FILE_KB=500
WORKSPACE_MAX_FILES=200
WORKSPACE_MAX_TOTAL_MB=20
# Phase 5: security (leave APP_PASSWORD empty for local-only use with no login)
APP_PASSWORD=
# SESSION_SECRET=            # optional; otherwise generated once into DATA_DIR/.session_secret
# COOKIE_SECURE=1            # set when served over HTTPS
# TRUST_PROXY=1              # set when behind nginx / Docker so rate limits see real client IPs
# CORS_ORIGIN=               # comma-separated origins; empty = same-origin only
# HOST=0.0.0.0
# Same random string as in ai-service/.env
INTERNAL_TOKEN=
